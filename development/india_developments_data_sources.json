    "keep_original_source_records": true
  },
  "company_aware_scoring": {
    "weights": {
      "domain": 0.24,
      "business": 0.18,
      "opportunity": 0.15,
      "geography": 0.10,
      "recency": 0.10,
      "source_authority": 0.10,
      "company_competitor_government": 0.10,
      "completeness": 0.02,
      "local_bonus": 0.01
    },
    "development_mix": {
      "external_domain": 0.30,
      "local_nearby_state": 0.20,
      "government_opportunity": 0.20,
      "competitor": 0.12,
      "national_global": 0.10,
      "company": 0.08
    },
