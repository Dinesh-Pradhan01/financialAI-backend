  "scoring": {
    "note": "Example scoring rubric for ranking retrieved records, not a measure of source truth or guaranteed accuracy.",
    "weights": {
      "topic_relevance": 0.35,
      "geographic_relevance": 0.2,
      "recency": 0.2,
      "source_authority": 0.15,
      "document_completeness": 0.1
    },
