{
  "config_name": "india_developments_data_sources",
  "version": "1.0.0",
  "last_reviewed": "2026-09-29",
  "purpose": "Discovery configuration for news and government procurement developments across all Indian states and union territories.",
  "important_notes": [
    "These are source landing pages and feed/API endpoints, not a guarantee that every source offers a public REST API.",
    "Most e-procurement portals require HTML page parsing, search-form interaction, downloads, or manual integration; verify each portal's terms, robots rules, rate limits, and technical access before automating.",
    "Do not assume the 15-minute update notices on individual portals guarantee event-to-detection latency.",
    "Google News RSS is included as an optional discovery feed; review applicable usage and licensing terms before using it in a commercial product.",
    "Gemini is an enrichment/normalization service, not an independent news source. Store its output separately from source evidence.",
    "Some official NIC directory links are legacy links or separate portals for regions now combined into one Union Territory. Confirm current operational status before production use."
  ],
  "global_sources": [
    {
      "source_id": "gdelt_doc",
      "name": "GDELT DOC API",
      "source_type": "news_search_api",
      "base_url": "https://api.gdeltproject.org/api/v2/doc/doc",
      "request_template": "https://api.gdeltproject.org/api/v2/doc/doc?query={URL_ENCODED_QUERY}&mode=ArtList&format=json&sort=DateDesc",
      "default_query_template": "(Bhubaneswar OR Odisha OR {STATE_OR_UT}) AND (development OR project OR investment OR tender OR surveillance OR CCTV)",
      "auth": "none_known",
      "recommended_poll_interval_minutes": 15,
      "latency_sla": null,
      "retrieval_mode": "http_api",
      "notes": "Use query parameters and response fields supported by the current GDELT DOC API. Validate rate limits and result coverage."
    },
    {
      "source_id": "google_news_rss",
      "name": "Google News RSS",
      "source_type": "news_rss",
      "base_url": "https://news.google.com/rss/search",
      "request_template": "https://news.google.com/rss/search?q={URL_ENCODED_QUERY}&hl=en-IN&gl=IN&ceid=IN:en",
      "default_query_template": "\"{STATE_OR_UT}\" (government OR project OR investment OR tender OR CCTV OR surveillance)",
      "auth": "none_for_feed_access",
      "recommended_poll_interval_minutes": 15,
      "latency_sla": null,
      "retrieval_mode": "rss",
      "notes": "Optional discovery layer. No guaranteed publication-to-feed latency; check applicable usage/licensing terms before commercial use."
    },
    {
      "source_id": "newsapi",
      "name": "NewsAPI",
      "source_type": "news_search_api",
      "base_url": "https://newsapi.org/v2/everything",
      "request_template": "https://newsapi.org/v2/everything?q={URL_ENCODED_QUERY}&language=en&sortBy=relevancy&pageSize=5&from={FROM_DATE}",
      "default_query_template": "\"{COMPANY_NAME}\" OR \"{BUSINESS_CATEGORY}\" AND \"{STATE_OR_UT}\"",
      "auth": "api_key_required",
      "recommended_poll_interval_minutes": 30,
      "latency_sla": null,
      "retrieval_mode": "http_api",
      "notes": "Optional source enabled when NEWSAPI_KEY is configured. This adds broader company-specific discovery coverage beyond the public RSS feeds."
    },
    {
      "source_id": "guardian_api",
      "name": "The Guardian API",
      "source_type": "news_search_api",
      "base_url": "https://content.guardianapis.com/search",
      "request_template": "https://content.guardianapis.com/search?q={URL_ENCODED_QUERY}&api-key={API_KEY}&page-size=5&show-fields=trailText&order-by=relevance",
      "default_query_template": "\"{COMPANY_NAME}\" OR \"{BUSINESS_CATEGORY}\" AND \"{STATE_OR_UT}\"",
      "auth": "api_key_required",
      "recommended_poll_interval_minutes": 30,
      "latency_sla": null,
      "retrieval_mode": "http_api",
      "notes": "Optional source enabled when THE_GUARDIAN_API_KEY or GUARDIAN_API_KEY is configured. Useful for business and policy coverage that complements the local/regional sources."
    },
    {
      "source_id": "central_cppp",
      "name": "Central Public Procurement Portal / Government eProcurement",
      "source_type": "government_procurement_portal",
      "base_url": "https://eprocure.gov.in/eprocure/app",
      "related_links_url": "https://www.eprocure.gov.in/epublish/app?page=FrontEndParticipatingSites&service=page",
      "recommended_poll_interval_minutes": 15,
      "latency_sla": null,
      "retrieval_mode": "portal_html_or_download",
      "notes": "Useful for central ministries, CPSEs, autonomous bodies, and central procurement. The portal is not represented here as a general-purpose public REST API."
    },
    {
      "source_id": "india_government_services_active_tenders",
      "name": "National Government Services Portal - Active Tenders",
      "source_type": "government_discovery_portal",
      "base_url": "https://services.india.gov.in/service/detail/search-active-tenders-of-state-and-central-government-organisations-1",
      "recommended_poll_interval_minutes": 30,
      "latency_sla": null,
      "retrieval_mode": "portal_html_or_user_search",
      "notes": "Discovery/search portal; confirm automation support before scraping."
    },
    {
      "source_id": "gemini_enrichment",
      "name": "Gemini API",
      "source_type": "ai_enrichment",
      "base_url": "https://generativelanguage.googleapis.com",
      "documentation_url": "https://ai.google.dev/gemini-api/docs",
      "auth": "api_key_required",
      "recommended_poll_interval_minutes": null,
      "latency_sla": null,
      "retrieval_mode": "api_after_source_ingestion",
      "notes": "Use after source retrieval to summarize, classify, extract entities/dates/locations, deduplicate, and generate company-specific relevance. Never use model output as sole evidence."
    }
  ],
